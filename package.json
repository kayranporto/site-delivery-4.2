{
  "name": "multi-delivery",
  "version": "4.4.5",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check-project.js",
    "verify": "npm run check && npm test && npm run check:edge",
    "package": "bash scripts/package-release.sh",
    "check:edge": "tsc -p tsconfig.edge.json",
    "configure:auth:no-confirm": "bash scripts/configurar-auth-sem-confirmacao.sh",
    "configure:auth:protection": "node scripts/configurar-protecao-auth.js"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
